# XAUUSD pro skalp — мысал (.env.example → .env көшіріп толтырыңыз)
DRY_RUN=true

MT5_SYMBOL_GOLD=XAUUSD
DEFAULT_LOT=0.1

XAU_SCALP_SYMBOL=XAUUSD
XAU_SCALP_MAGIC=202609
XAU_SCALP_LOT=0.1
XAU_SCALP_POLL_SECONDS=15

# Kill zone (UTC 7-17 = local UTC+5: 12:00-22:00)
XAU_SCALP_KILL_ZONES=7-17
XAU_SCALP_MAX_SPREAD_POINTS=35
XAU_SCALP_MAX_TRADES_DAY=100
XAU_SCALP_COOLDOWN_SEC=300
XAU_SCALP_MAX_HOLD_MIN=30

# ATR SL/TP
XAU_SCALP_USE_ATR_SLTP=true
XAU_SCALP_ATR_PERIOD=14
XAU_SCALP_ATR_SL_MULT=1.2
XAU_SCALP_ATR_TP_MULT=1.8
XAU_SCALP_MIN_RR=1.3
XAU_SCALP_SL_POINTS=250
XAU_SCALP_TP_POINTS=375
XAU_SCALP_SL_BUFFER_POINTS=40
XAU_SCALP_SWEEP_WICK_POINTS=20
XAU_SCALP_SWING_LOOKBACK=3

# Consensus (sweep joq fallback)
XAU_SCALP_CONSENSUS_ENTRY=true
XAU_SCALP_CONSENSUS_MIN_CONFIDENCE=70

# Position management
XAU_SCALP_BREAKEVEN_R=0.7
XAU_SCALP_TRAIL_START_R=1.0
XAU_SCALP_TRAIL_POINTS=150

# Filters
XAU_SCALP_USE_RSI_FILTER=true
XAU_SCALP_USE_EMA_FILTER=true
XAU_SCALP_USE_H1_TREND=true
XAU_SCALP_RSI_PERIOD=7
XAU_SCALP_USE_NEWS_FILTER=true
XAU_SCALP_NEWS_BLOCK_MIN=15
XAU_SCALP_NEWS_BLOCK_MEDIUM=false

# Web signal
XAU_SCALP_USE_WEB_SIGNALS=true
XAU_SCALP_WEB_SOURCE=investing
XAU_SCALP_WEB_TIMEFRAME=15min
XAU_SCALP_WEB_CACHE_SEC=180
XAU_SCALP_WEB_BLOCK_NEUTRAL=true
XAU_SCALP_WEB_MIN_STRENGTH=strong
XAU_SCALP_INVESTING_PAIR_ID=8830

# Smart indicators
XAU_SCALP_SMART_INDICATORS=true
XAU_SCALP_INDICATOR_MIN_TRADES=3
XAU_SCALP_INDICATOR_MIN_WEIGHT=3
XAU_SCALP_ADAPTIVE=false
XAU_SCALP_INVERT_SIGNALS=false
XAU_SCALP_ADAPTIVE_MIN_TRADES=2
XAU_SCALP_SKIP_LOSING_SLOTS=true
XAU_SCALP_SLOT_MIN_TRADES=4

# Confidence
XAU_SCALP_MIN_CONFIDENCE=60
XAU_SCALP_CONFIDENCE_LOT_HIGH=80
XAU_SCALP_LOT_HIGH=0.1

# Drawdown guard
XAU_SCALP_DRAWDOWN_GUARD=true
XAU_SCALP_MAX_DAILY_LOSS=500
XAU_SCALP_RECOVERY_MODE=true
XAU_SCALP_RECOVERY_MIN_SCORE=80

# DXY
XAU_SCALP_USE_DXY_FILTER=true
XAU_SCALP_DXY_FALLBACKS=USDX,DXY,USDIndex

# Partial TP
XAU_SCALP_PARTIAL_TP=true
XAU_SCALP_PARTIAL_TP_R=1.0
XAU_SCALP_PARTIAL_TP_PCT=50
